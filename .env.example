# Copy this file to .env.local and fill in real values.
# Local values below match `supabase start` output for this project
# (run `supabase status` to regenerate if they ever rotate).

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55921
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose this to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3010

# --- Enquiry email alerts -------------------------------------------------
# Every new enquiry emails ENQUIRY_ALERT_TO (comma-separated for several staff).
# Production with Gmail: create an App Password (Google Account → Security →
# 2-Step Verification → App passwords) and use:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true
#   SMTP_USER=srmotors@gmail.com  SMTP_PASS=<16-character app password>
# Local dev: the values below deliver to the Supabase mail catcher at
# http://127.0.0.1:55924 — nothing is actually sent.
SMTP_HOST=127.0.0.1
SMTP_PORT=55925
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ENQUIRY_ALERT_TO=srmotors@gmail.com
ENQUIRY_ALERT_FROM="SR Motors Website <alerts@srmotors.local>"

# --- Google (optional, fill in once configured) ---------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=

# --- End-to-end tests (local only — never set in production) -------------
# E2E_ADMIN_EMAIL=admin@srmotors.test
# E2E_ADMIN_PASSWORD=
